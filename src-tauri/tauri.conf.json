{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLite PDF Reader",
  "version": "1.0.0",
  "identifier": "com.paperlite.pdfreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLite PDF Reader",
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
