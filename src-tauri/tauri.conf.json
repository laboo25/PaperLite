{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperLite PDF Reader",
  "version": "1.0.0",
  "identifier": "com.paperlite.pdfreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperLite PDF Reader",
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/pdf-icon.ico"
    ],
    "resources": [
      "icons/icon.ico",
      "icons/pdf-icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format File",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.ico"
      }
    }
  }
}
